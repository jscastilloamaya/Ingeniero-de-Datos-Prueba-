{
	"name": "Reportes",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "fechasok",
						"type": "DatasetReference"
					},
					"name": "DataSilver"
				},
				{
					"dataset": {
						"referenceName": "AzureSynapseAnalyticsTableCliente",
						"type": "DatasetReference"
					},
					"name": "TablaClientes"
				},
				{
					"dataset": {
						"referenceName": "AzureSynapseAnalyticsTableTiempo",
						"type": "DatasetReference"
					},
					"name": "TablaTiempo"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "AzureSynapseAnalyticsTableReportes",
						"type": "DatasetReference"
					},
					"name": "ReporteGold"
				}
			],
			"transformations": [
				{
					"name": "IdCliente"
				},
				{
					"name": "IdTiempo"
				},
				{
					"name": "FiltraReportes"
				},
				{
					"name": "idReporte"
				},
				{
					"name": "ColumnasNecesarias"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {tipo de identificación} as string,",
				"          {número de identificación} as string,",
				"          {número de cuenta} as string,",
				"          nombres as string,",
				"          {tipo transacción} as string,",
				"          {monto transacción} as string,",
				"          {tipo de producto} as string,",
				"          ciudad as string,",
				"          {fecha-hora} as string,",
				"          {fecha de nacimiento} as string,",
				"          {dirección del cliente} as string,",
				"          {teléfono del cliente} as string,",
				"          {correo del cliente} as string,",
				"          {reporte centrales de riesgo} as string,",
				"          {monto reporte de central de riesgo} as string,",
				"          {tiempo en mora del reporte de riesgo} as string,",
				"          fecha_hora_normalizada as string,",
				"          fecha as string,",
				"          hora as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> DataSilver",
				"source(output(",
				"          id_cliente as integer,",
				"          tipo_identificacion as string,",
				"          numero_identificacion as string,",
				"          nombres as string,",
				"          fecha_nacimiento as date,",
				"          direccion as string,",
				"          telefono as string,",
				"          correo as string,",
				"          id_ciudad as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table',",
				"     staged: true) ~> TablaClientes",
				"source(output(",
				"          id_tiempo as integer,",
				"          fecha as date,",
				"          anno as integer,",
				"          mes as integer,",
				"          dia as integer,",
				"          trimestre as string,",
				"          nombre_mes as string,",
				"          dia_semana as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table',",
				"     staged: true) ~> TablaTiempo",
				"DataSilver, TablaClientes join({tipo de identificación} == tipo_identificacion,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> IdCliente",
				"IdCliente, TablaTiempo join(DataSilver@fecha == toString(TablaTiempo@fecha,'yyyy-MM-dd'),",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> IdTiempo",
				"IdTiempo filter({reporte centrales de riesgo}=='Sí') ~> FiltraReportes",
				"FiltraReportes keyGenerate(output(id_reporte as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> idReporte",
				"idReporte select(mapColumn(",
				"          {id_reporte } = id_reporte,",
				"          id_cliente,",
				"          id_tiempo,",
				"          reporte_central_riesgo = {reporte centrales de riesgo},",
				"          {monto_reporte } = {monto reporte de central de riesgo},",
				"          tiempo_mora = {tiempo en mora del reporte de riesgo}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> ColumnasNecesarias",
				"ColumnasNecesarias sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          id_reporte as long,",
				"          id_cliente as integer,",
				"          id_tiempo as integer,",
				"          reporte_central_riesgo as string,",
				"          monto_reporte as decimal(18,2),",
				"          tiempo_mora as string,",
				"          fecha_carga as timestamp,",
				"          batch_id as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> ReporteGold"
			]
		}
	}
}