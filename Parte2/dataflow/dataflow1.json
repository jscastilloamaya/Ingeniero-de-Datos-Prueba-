{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "fechasok",
						"type": "DatasetReference"
					},
					"name": "DataSilver"
				},
				{
					"dataset": {
						"referenceName": "AzureSynapseAnalyticsTableCliente",
						"type": "DatasetReference"
					},
					"name": "TablaClientes"
				},
				{
					"dataset": {
						"referenceName": "AzureSynapseAnalyticsTableTiempo",
						"type": "DatasetReference"
					},
					"name": "TablaTiempo"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "IdCliente"
				},
				{
					"name": "IdTiempo"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {tipo de identificación} as string,",
				"          {número de identificación} as string,",
				"          {número de cuenta} as string,",
				"          nombres as string,",
				"          {tipo transacción} as string,",
				"          {monto transacción} as string,",
				"          {tipo de producto} as string,",
				"          ciudad as string,",
				"          {fecha-hora} as string,",
				"          {fecha de nacimiento} as string,",
				"          {dirección del cliente} as string,",
				"          {teléfono del cliente} as string,",
				"          {correo del cliente} as string,",
				"          {reporte centrales de riesgo} as string,",
				"          {monto reporte de central de riesgo} as string,",
				"          {tiempo en mora del reporte de riesgo} as string,",
				"          fecha_hora_normalizada as string,",
				"          fecha as string,",
				"          hora as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> DataSilver",
				"source(output(",
				"          id_cliente as integer,",
				"          tipo_identificacion as string,",
				"          numero_identificacion as string,",
				"          nombres as string,",
				"          fecha_nacimiento as date,",
				"          direccion as string,",
				"          telefono as string,",
				"          correo as string,",
				"          id_ciudad as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table',",
				"     staged: true) ~> TablaClientes",
				"source(output(",
				"          id_tiempo as integer,",
				"          fecha as date,",
				"          anno as integer,",
				"          mes as integer,",
				"          dia as integer,",
				"          trimestre as string,",
				"          nombre_mes as string,",
				"          dia_semana as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table',",
				"     staged: true) ~> TablaTiempo",
				"DataSilver, TablaClientes join({tipo de identificación} == tipo_identificacion,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> IdCliente",
				"IdCliente, TablaTiempo join(DataSilver@fecha == toString(TablaTiempo@fecha,'yyyy-MM-dd'),",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> IdTiempo",
				"IdTiempo filter({reporte centrales de riesgo}=='Si') ~> filter1"
			]
		}
	}
}