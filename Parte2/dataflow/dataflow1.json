{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DCrudos",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "AzureSynapseAnalyticsTableProduc",
						"type": "DatasetReference"
					},
					"name": "TPGOLD"
				},
				{
					"dataset": {
						"referenceName": "AzureSynapseAnalyticsTableCiudad",
						"type": "DatasetReference"
					},
					"name": "CIUDGOLD"
				}
			],
			"transformations": [
				{
					"name": "TP"
				},
				{
					"name": "TPEliminarDupiclados"
				},
				{
					"name": "TPID"
				},
				{
					"name": "TPSilver"
				},
				{
					"name": "ciud"
				},
				{
					"name": "ciudElmiminarDuplicados"
				},
				{
					"name": "ciudID"
				},
				{
					"name": "ciudSilver"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {tipo de identificación} as string,",
				"          {número de identificación} as string,",
				"          {número de cuenta} as string,",
				"          nombres as string,",
				"          {tipo transacción} as string,",
				"          {monto transacción} as string,",
				"          {tipo de producto} as string,",
				"          ciudad as string,",
				"          {fecha-hora} as string,",
				"          {fecha de nacimiento} as string,",
				"          {dirección del cliente} as string,",
				"          {teléfono del cliente} as string,",
				"          {correo del cliente} as string,",
				"          {reporte centrales de riesgo} as string,",
				"          {monto reporte de central de riesgo} as string,",
				"          {tiempo en mora del reporte de riesgo} as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 select(mapColumn(",
				"          {tipo de producto}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> TP",
				"TP aggregate(groupBy(mycols = sha2(256,columns())),",
				"     each(match(true()), $$ = first($$))) ~> TPEliminarDupiclados",
				"TPEliminarDupiclados keyGenerate(output(id_producto as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> TPID",
				"TPID select(mapColumn(",
				"          tipo_producto = {tipo de producto},",
				"          id_producto",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> TPSilver",
				"source1 select(mapColumn(",
				"          ciudad",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> ciud",
				"ciud aggregate(groupBy(mycols = sha2(256,columns())),",
				"     each(match(true()), $$ = first($$))) ~> ciudElmiminarDuplicados",
				"ciudElmiminarDuplicados keyGenerate(output(id_ciudad as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> ciudID",
				"ciudID select(mapColumn(",
				"          mycols,",
				"          ciudad,",
				"          id_ciudad",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> ciudSilver",
				"TPSilver sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          id_producto as integer,",
				"          tipo_producto as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> TPGOLD",
				"ciudSilver sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          id_ciudad as integer,",
				"          ciudad as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> CIUDGOLD"
			]
		}
	}
}