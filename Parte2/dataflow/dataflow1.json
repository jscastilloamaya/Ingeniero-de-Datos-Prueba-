{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "fechasok",
						"type": "DatasetReference"
					},
					"name": "DatosSilver"
				},
				{
					"dataset": {
						"referenceName": "AzureSynapseAnalyticsTableCliente",
						"type": "DatasetReference"
					},
					"name": "Tablacliente"
				},
				{
					"dataset": {
						"referenceName": "AzureSynapseAnalyticsTableTiempo",
						"type": "DatasetReference"
					},
					"name": "TablaTiempo"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "IdCliente"
				},
				{
					"name": "IDTiempo"
				},
				{
					"name": "ColumnasNecesarias"
				},
				{
					"name": "Reportes"
				},
				{
					"name": "surrogateKey1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {tipo de identificación} as string,",
				"          {número de identificación} as string,",
				"          {número de cuenta} as string,",
				"          nombres as string,",
				"          {tipo transacción} as string,",
				"          {monto transacción} as string,",
				"          {tipo de producto} as string,",
				"          ciudad as string,",
				"          {fecha-hora} as string,",
				"          {fecha de nacimiento} as string,",
				"          {dirección del cliente} as string,",
				"          {teléfono del cliente} as string,",
				"          {correo del cliente} as string,",
				"          {reporte centrales de riesgo} as string,",
				"          {monto reporte de central de riesgo} as string,",
				"          {tiempo en mora del reporte de riesgo} as string,",
				"          fecha_hora_normalizada as string,",
				"          fecha as string,",
				"          hora as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> DatosSilver",
				"source(output(",
				"          id_cliente as integer,",
				"          tipo_identificacion as string,",
				"          numero_identificacion as string,",
				"          nombres as string,",
				"          fecha_nacimiento as date,",
				"          direccion as string,",
				"          telefono as string,",
				"          correo as string,",
				"          id_ciudad as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table',",
				"     staged: true) ~> Tablacliente",
				"source(output(",
				"          id_tiempo as integer,",
				"          fecha as date,",
				"          anno as integer,",
				"          mes as integer,",
				"          dia as integer,",
				"          trimestre as string,",
				"          nombre_mes as string,",
				"          dia_semana as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table',",
				"     staged: true) ~> TablaTiempo",
				"DatosSilver, Tablacliente join({tipo de identificación} == numero_identificacion,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> IdCliente",
				"IdCliente, TablaTiempo join(DatosSilver@fecha == toString(TablaTiempo@fecha,'yyyy-MM-dd'),",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> IDTiempo",
				"IDTiempo select(mapColumn(",
				"          id_cliente,",
				"          id_tiempo,",
				"          reporte_central_riesgo = {reporte centrales de riesgo},",
				"          monto_reporte = {monto reporte de central de riesgo},",
				"          {tiempo_mora } = {tiempo en mora del reporte de riesgo}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> ColumnasNecesarias",
				"ColumnasNecesarias filter(reporte_central_riesgo=='Sí') ~> Reportes",
				"Reportes keyGenerate(output(id_reporte as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateKey1"
			]
		}
	}
}