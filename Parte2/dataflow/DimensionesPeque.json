{
	"name": "DimensionesPeque",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "fechasok",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "AzureSynapseAnalyticsTableCiudad",
						"type": "DatasetReference"
					},
					"name": "CIUDGOLD"
				},
				{
					"dataset": {
						"referenceName": "AzureSynapseAnalyticsTableTiempo",
						"type": "DatasetReference"
					},
					"name": "FechaGOLD"
				},
				{
					"dataset": {
						"referenceName": "AzureSynapseAnalyticsTableProduc",
						"type": "DatasetReference"
					},
					"name": "TPGOLD"
				}
			],
			"transformations": [
				{
					"name": "TP"
				},
				{
					"name": "TPEliminarDupiclados"
				},
				{
					"name": "TPID"
				},
				{
					"name": "TPSilver"
				},
				{
					"name": "ciud"
				},
				{
					"name": "ciudElmiminarDuplicados"
				},
				{
					"name": "ciudID"
				},
				{
					"name": "ciudSilver"
				},
				{
					"name": "fechaa"
				},
				{
					"name": "fechaEliminarDuplicados"
				},
				{
					"name": "fechaid"
				},
				{
					"name": "fechaSilver"
				},
				{
					"name": "TiempoDerivado"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {tipo de identificación} as string,",
				"          {número de identificación} as string,",
				"          {número de cuenta} as string,",
				"          nombres as string,",
				"          {tipo transacción} as string,",
				"          {monto transacción} as string,",
				"          {tipo de producto} as string,",
				"          ciudad as string,",
				"          {fecha-hora} as string,",
				"          {fecha de nacimiento} as string,",
				"          {dirección del cliente} as string,",
				"          {teléfono del cliente} as string,",
				"          {correo del cliente} as string,",
				"          {reporte centrales de riesgo} as string,",
				"          {monto reporte de central de riesgo} as string,",
				"          {tiempo en mora del reporte de riesgo} as string,",
				"          fecha_hora_normalizada as string,",
				"          fecha as string,",
				"          hora as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 select(mapColumn(",
				"          {tipo de producto}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> TP",
				"TP aggregate(groupBy(mycols = sha2(256,columns())),",
				"     each(match(true()), $$ = first($$))) ~> TPEliminarDupiclados",
				"TPEliminarDupiclados keyGenerate(output(id_producto as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> TPID",
				"TPID select(mapColumn(",
				"          tipo_producto = {tipo de producto},",
				"          id_producto",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> TPSilver",
				"source1 select(mapColumn(",
				"          ciudad",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> ciud",
				"ciud aggregate(groupBy(mycols = sha2(256,columns())),",
				"     each(match(true()), $$ = first($$))) ~> ciudElmiminarDuplicados",
				"ciudElmiminarDuplicados keyGenerate(output(id_ciudad as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> ciudID",
				"ciudID select(mapColumn(",
				"          mycols,",
				"          ciudad,",
				"          id_ciudad",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> ciudSilver",
				"source1 select(mapColumn(",
				"          fecha",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> fechaa",
				"fechaa aggregate(groupBy(mycols = sha2(256,columns())),",
				"     each(match(true()), $$ = first($$))) ~> fechaEliminarDuplicados",
				"fechaEliminarDuplicados keyGenerate(output(id_tiempo as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> fechaid",
				"fechaid select(mapColumn(",
				"          fecha,",
				"          id_tiempo",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> fechaSilver",
				"fechaSilver derive(fecha = toDate(fecha, 'yyyy-MM-dd'),",
				"          anno = year(toDate(fecha, 'yyyy-MM-dd')),",
				"          mes = month(toDate(fecha, 'yyyy-MM-dd')),",
				"          dia = dayOfMonth(toDate(fecha, 'yyyy-MM-dd')),",
				"          trimestre = concat('Q', toString(ceil(month(toDate(fecha, 'yyyy-MM-dd')) / 3.0))),",
				"          nombre_mes = case(month(toDate(fecha, 'yyyy-MM-dd')) == 1, 'Enero',",
				"            month(toDate(fecha, 'yyyy-MM-dd')) == 2, 'Febrero',",
				"            month(toDate(fecha, 'yyyy-MM-dd')) == 3, 'Marzo',",
				"            month(toDate(fecha, 'yyyy-MM-dd')) == 4, 'Abril',",
				"            month(toDate(fecha, 'yyyy-MM-dd')) == 5, 'Mayo',",
				"            month(toDate(fecha, 'yyyy-MM-dd')) == 6, 'Junio',",
				"            month(toDate(fecha, 'yyyy-MM-dd')) == 7, 'Julio',",
				"            month(toDate(fecha, 'yyyy-MM-dd')) == 8, 'Agosto',",
				"            month(toDate(fecha, 'yyyy-MM-dd')) == 9, 'Septiembre',",
				"            month(toDate(fecha, 'yyyy-MM-dd')) == 10, 'Octubre',",
				"            month(toDate(fecha, 'yyyy-MM-dd')) == 11, 'Noviembre',",
				"            'Diciembre'),",
				"          dia_semana = case(dayOfWeek(toDate(fecha, 'yyyy-MM-dd')) == 1, 'Domingo',",
				"            dayOfWeek(toDate(fecha, 'yyyy-MM-dd')) == 2, 'Lunes',",
				"            dayOfWeek(toDate(fecha, 'yyyy-MM-dd')) == 3, 'Martes',",
				"            dayOfWeek(toDate(fecha, 'yyyy-MM-dd')) == 4, 'Miércoles',",
				"            dayOfWeek(toDate(fecha, 'yyyy-MM-dd')) == 5, 'Jueves',",
				"            dayOfWeek(toDate(fecha, 'yyyy-MM-dd')) == 6, 'Viernes',",
				"            'Sábado'),",
				"          id_tiempo = id_tiempo) ~> TiempoDerivado",
				"ciudSilver sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          id_ciudad as integer,",
				"          ciudad as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> CIUDGOLD",
				"TiempoDerivado sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          id_tiempo as integer,",
				"          fecha as date,",
				"          anno as integer,",
				"          mes as integer,",
				"          dia as integer,",
				"          trimestre as string,",
				"          nombre_mes as string,",
				"          dia_semana as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> FechaGOLD",
				"TPSilver sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          id_producto as integer,",
				"          tipo_producto as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> TPGOLD"
			]
		}
	}
}