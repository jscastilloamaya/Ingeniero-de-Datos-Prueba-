{
	"name": "Silver",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DCrudos",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "RevisarNacimientos",
						"type": "DatasetReference"
					},
					"name": "RevisarNacimiento"
				},
				{
					"dataset": {
						"referenceName": "fechasok",
						"type": "DatasetReference"
					},
					"name": "fechasok"
				}
			],
			"transformations": [
				{
					"name": "FechaNormalizada"
				},
				{
					"name": "menores1950"
				},
				{
					"name": "mayorigul1950"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {tipo de identificación} as string,",
				"          {número de identificación} as string,",
				"          {número de cuenta} as string,",
				"          nombres as string,",
				"          {tipo transacción} as string,",
				"          {monto transacción} as string,",
				"          {tipo de producto} as string,",
				"          ciudad as string,",
				"          {fecha-hora} as string,",
				"          {fecha de nacimiento} as string,",
				"          {dirección del cliente} as string,",
				"          {teléfono del cliente} as string,",
				"          {correo del cliente} as string,",
				"          {reporte centrales de riesgo} as string,",
				"          {monto reporte de central de riesgo} as string,",
				"          {tiempo en mora del reporte de riesgo} as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(fecha_hora_normalizada = iif(regexMatch({fecha-hora}, `^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$`), toTimestamp({fecha-hora}, 'yyyy-MM-dd HH:mm:ss'), toTimestamp(toLong({fecha-hora}) * 1000L)),",
				"          fecha = toDate(iif(regexMatch({fecha-hora}, `^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$`), toTimestamp({fecha-hora}, 'yyyy-MM-dd HH:mm:ss'), toTimestamp(toLong({fecha-hora}) * 1000L))),",
				"          hora = hour(iif(regexMatch({fecha-hora}, `^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$`), toTimestamp({fecha-hora}, 'yyyy-MM-dd HH:mm:ss'), toTimestamp(toLong({fecha-hora}) * 1000L)))) ~> FechaNormalizada",
				"FechaNormalizada filter(year(toDate({fecha de nacimiento}, 'yyyy-MM-dd')) < 1950) ~> menores1950",
				"FechaNormalizada filter(year(toDate({fecha de nacimiento}, 'yyyy-MM-dd')) >= 1950) ~> mayorigul1950",
				"menores1950 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> RevisarNacimiento",
				"mayorigul1950 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          {tipo de identificación} as string,",
				"          {número de identificación} as string,",
				"          {número de cuenta} as string,",
				"          nombres as string,",
				"          {tipo transacción} as string,",
				"          {monto transacción} as string,",
				"          {tipo de producto} as string,",
				"          ciudad as string,",
				"          {fecha-hora} as string,",
				"          {fecha de nacimiento} as string,",
				"          {dirección del cliente} as string,",
				"          {teléfono del cliente} as string,",
				"          {correo del cliente} as string,",
				"          {reporte centrales de riesgo} as string,",
				"          {monto reporte de central de riesgo} as string,",
				"          {tiempo en mora del reporte de riesgo} as string,",
				"          fecha_hora_normalizada as string,",
				"          fecha as string,",
				"          hora as string",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> fechasok"
			]
		}
	}
}